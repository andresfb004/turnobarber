# Token que entrega @BotFather al crear el bot
BOT_TOKEN=

# URL de la API (terminada en /api)
API_URL=https://turnobarber-production.up.railway.app/api

# Usuario del bot en la API (lo crea el seeder de Laravel)
BOT_EMAIL=bot@turnobarber.test
BOT_PASSWORD=

# Opcionales
ZONA_HORARIA=America/Bogota
MINUTOS_RECORDATORIOS=10
DIAS_PARA_AGENDAR=7

# Nombre que verán los clientes en Telegram (opcional)
BARBERIA_NOMBRE=

# Persona que atiende cuando el cliente pide hablar con alguien
ENCARGADO_NOMBRE=David
# IDs de Telegram que reciben el aviso, separados por coma (cada uno lo obtiene con /miid)
AVISOS_TELEGRAM_IDS=

# Conversación con IA. Vacío: el bot funciona solo con botones
IA_PROVEEDOR=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODELO=qwen3.5:9b
# Solo con el modelo detrás del túnel: la genera y muestra `npm run ia:tunel`
OLLAMA_CLAVE=
