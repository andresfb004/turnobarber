  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api"
    },
    {
      "key": "bot_email",
      "value": "bot@turnobarber.test"
    },
    {
      "key": "bot_password",
      "value": "password"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "telegram_id",
      "value": "555000111"
    },
    {
      "key": "telegram_id_bloqueado",
      "value": "900000001"
    },
    {
      "key": "profesional_id",
      "value": "1"
    },
    {
      "key": "fecha",
      "value": ""
    },
    {
      "key": "inicio",
      "value": ""
    },
    {
      "key": "cita_id",
      "value": ""
    },
    {
      "key": "admin_email",
      "value": "barbero@turnobarber.test"
    },
    {
      "key": "admin_password",
      "value": "password"
    },
    {
      "key": "token_admin",
      "value": ""
    },
    {
      "key": "inicio_otro",
      "value": ""
    },
    {
      "key": "profesional_nuevo_id",
      "value": ""
    },
    {
      "key": "profesional_nuevo_email",
      "value": ""
