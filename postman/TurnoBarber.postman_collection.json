{
  "info": {
    "name": "TurnoBarber API",
    "description": "API del sistema de citas de la barbería. Ejecuta primero la carpeta 'Flujo del bot' en orden; luego 'Errores esperados'.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api"
    },
    {
      "key": "bot_email",
      "value": "bot@turnobarber.test"
    },
    {
      "key": "bot_password",
      "value": "password"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "telegram_id",
      "value": "555000111"
    },
    {
      "key": "telegram_id_bloqueado",
      "value": "900000001"
    },
    {
      "key": "profesional_id",
      "value": "1"
    },
    {
      "key": "fecha",
      "value": ""
    },
    {
      "key": "inicio",
      "value": ""
    },
    {
      "key": "cita_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Flujo del bot",
      "item": [
        {
          "name": "Login del bot",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{bot_email}}\",\n  \"password\": \"{{bot_password}}\",\n  \"device_name\": \"postman\"\n}"
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Guarda el token en la variable {{token}} para el resto de peticiones."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Vincular cliente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/clientes/vincular",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "clientes",
                "vincular"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"telegram_id\": \"{{telegram_id}}\",\n  \"telefono\": \"+57 300 555 0101\",\n  \"nombre\": \"Cliente de Postman\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201 (nuevo) o 200 (ya existía)', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar profesionales",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/profesionales",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "profesionales"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('profesional_id', pm.response.json().data[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Turnos libres",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/turnos?profesional={{profesional_id}}&fecha={{fecha}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "turnos"
              ],
              "query": [
                {
                  "key": "profesional",
                  "value": "{{profesional_id}}"
                },
                {
                  "key": "fecha",
                  "value": "{{fecha}}"
                }
              ]
            },
            "description": "Consulta el próximo día hábil y guarda el primer turno libre en {{inicio}}."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Próximo día de lunes a sábado, en hora de Colombia.",
                  "const hoy = new Date(Date.now() - 5 * 3600 * 1000);",
                  "const d = new Date(Date.UTC(hoy.getUTCFullYear(), hoy.getUTCMonth(), hoy.getUTCDate() + 1));",
                  "if (d.getUTCDay() === 0) d.setUTCDate(d.getUTCDate() + 1);",
                  "pm.collectionVariables.set('fecha', d.toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const t = pm.response.json().data;",
                  "if (t.length) pm.collectionVariables.set('inicio', t[0].inicio);"
                ]
              }
            }
          ]
        },
        {
          "name": "Agendar cita",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/citas",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "citas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"telegram_id\": \"{{telegram_id}}\",\n  \"profesional_id\": \"{{profesional_id}}\",\n  \"inicio\": \"{{inicio}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('cita_id', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Ver cita",
